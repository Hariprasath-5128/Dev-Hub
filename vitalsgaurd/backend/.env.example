MISTRAL_API_KEY=your_mistral_api_key_here
ALERT_EMAIL_RECIPIENT=emergency@example.com

# Telegram alerts — create a bot via @BotFather on Telegram to get the token,
# then message the bot once and fetch your chat_id (see README for the helper script).
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# Optional — same project/keys as vitalsgaurd/server/.env. When set, agent
# tools (get_patient_profile, get_vitals, get_reports, get_doctor_contacts,
# create_emergency_event, ...) read/write real Supabase tables instead of
# the in-memory simulated data store. Run server/supabase_schema_agents.sql
# against your project first. Leave blank to keep using simulated data.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Shared with vitalsgaurd/server/.env — must be identical on both sides.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=

# Shared with vitalsgaurd/server/.env — must be identical on both sides.
INTERNAL_SERVICE_KEY=
NODE_BACKEND_URL=http://localhost:5003
